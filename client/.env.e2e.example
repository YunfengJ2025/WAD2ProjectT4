# Copy to .env.e2e.local (ignored by Git). Use dedicated test accounts/database.
E2E_CONFIRM_TEST_ENV=true
E2E_USER_A_EMAIL=your-test-account-a@example.com
E2E_USER_A_PASSWORD=your-test-password-a
E2E_USER_B_EMAIL=your-test-account-b@example.com
E2E_USER_B_PASSWORD=your-test-password-b

# Optional: deployed/test frontend. Unset means start Vite at localhost:5173.
# E2E_BASE_URL=https://your-test-frontend.example.com
# Optional: separate backend origin, WITHOUT /api. Match VITE_API_BASE_URL.
# Unset means API checks use E2E_BASE_URL + /api through the frontend proxy.
# E2E_API_BASE_URL=https://your-test-backend.example.com
# Optional: use an installed browser instead of downloading Playwright Chromium.
# E2E_BROWSER_CHANNEL=chrome
